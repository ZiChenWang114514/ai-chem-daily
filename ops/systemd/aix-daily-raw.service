[Unit]
Description=AIX Daily metadata collection on Zeus
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/data3/zcwang/daily-intelligence-hub/app
Environment=TZ=Asia/Shanghai
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/bash /data3/zcwang/daily-intelligence-hub/app/ops/zeus_daily.sh
