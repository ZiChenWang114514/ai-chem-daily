{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["date", "channel", "editor_note", "selected"],
  "additionalProperties": false,
  "properties": {
    "date": {"type": "string", "format": "date"},
    "channel": {"enum": ["aixchem", "aixbio", "aixmath", "aivoices", "engineering"]},
    "editor_note": {"type": "string"},
    "selected": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": ["id", "category", "summary_zh", "why_it_matters_zh", "quality_score", "tags", "evidence_flags", "related_channels"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string"},
          "category": {"type": "string"},
          "summary_zh": {"type": "string"},
          "why_it_matters_zh": {"type": "string"},
          "quality_score": {"type": "number", "minimum": 0, "maximum": 100},
          "tags": {"type": "array", "items": {"type": "string"}, "maxItems": 6},
          "evidence_flags": {"type": "array", "items": {"type": "string"}, "maxItems": 6},
          "related_channels": {"type": "array", "items": {"enum": ["aixchem", "aixbio", "aixmath", "aivoices", "engineering"]}}
        }
      }
    }
  }
}
